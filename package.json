{
  "name": "proti-demo",
  "private": true,
  "version": "0.7.0",
  "scripts": {
    "dev:web": "pnpm --dir web dev",
    "dev:studio": "pnpm --dir studio dev",
    "build:web": "pnpm --dir web build",
    "build:studio": "pnpm --dir studio build",
    "proti:init": "node scripts/proti-init.mjs",
    "proti:visual:init": "node scripts/proti-visual-init.mjs",
    "proti:configure:production": "node scripts/proti-configure-production.mjs",
    "proti:seed": "node scripts/proti-seed.mjs",
    "test:proti": "node --test scripts/proti-init.test.mjs scripts/proti-seed.test.mjs scripts/proti-check.test.mjs scripts/proti-visual-init.test.mjs scripts/proti-configure-production.test.mjs scripts/proti-acceptance.test.mjs scripts/proti-env-check.test.mjs scripts/proti-verify.test.mjs scripts/proti-dx-regression.test.mjs",
    "test:proti:dx": "node --test scripts/proti-dx-regression.test.mjs",
    "proti:check": "node scripts/proti-check.mjs",
    "test:proti:integration": "node --test scripts/proti-acceptance.test.mjs",
    "proti:env:check": "node scripts/proti-env-check.mjs",
    "build:web:checked": "pnpm proti:env:check --target=web --mode=development && pnpm --dir web build",
    "build:studio:checked": "pnpm proti:env:check --target=studio --mode=development && pnpm --dir studio build",
    "proti:commands": "node scripts/proti-verify.mjs --help",
    "verify:quick": "node scripts/proti-verify.mjs quick",
    "verify:fixtures": "node scripts/proti-verify.mjs fixtures",
    "verify:performance": "node scripts/proti-verify.mjs performance",
    "verify:all": "node scripts/proti-verify.mjs all"
  }
}
