# Base URL used by Playwright.
PLAYWRIGHT_BASE_URL=http://127.0.0.1:3000

# By default Playwright starts the web app with `pnpm dev`.
# Override this only if your web package uses a different command.
# PLAYWRIGHT_WEB_SERVER_COMMAND=pnpm dev

# Set this to 1 when you want Playwright to test a server that you started
# yourself (or a remote environment) instead of launching `pnpm dev`.
# PLAYWRIGHT_SKIP_WEBSERVER=1

# Homepage is included by default even if this line is omitted.
E2E_HOME_PATH=/

# Add only routes that exist in your current Sanity content.
# These examples match route shapes used by Proti.
# E2E_PAGE_PATH=/products/widget
# E2E_BLOG_PATH=/blog/nutrition-basics
# E2E_AUTHOR_PATH=/authors/jane-doe
# E2E_TAXONOMY_PATH=/blog/topics/nutrition
# E2E_SEARCH_PATH=/search?q=nutrition
# E2E_SECONDARY_LOCALE_PATH=/es-us/products/widget
