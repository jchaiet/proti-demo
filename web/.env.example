# Proti Web
NEXT_SANITY_PROJECT_ID=your-sanity-project-id
NEXT_SANITY_DATASET=production
NEXT_SANITY_STUDIO_URL=http://localhost:3333

# Required for Draft Mode / Visual Editing.
SANITY_API_READ_TOKEN=

# Required for local seed/write workflows.
SANITY_API_WRITE_TOKEN=

# Secret shared with the Sanity revalidation webhook.
SANITY_REVALIDATE_SECRET=

# Poll Security
POLL_VISITOR_SECRET=
POLL_RATE_LIMIT_SALT=

# Upstash Redis
POLL_UPSTASH_REDIS_REST_URL=
POLL_UPSTASH_REDIS_REST_TOKEN=

# Security
POLL_TRUST_PROXY_HEADERS=false
POLL_ALLOWED_ORIGINS=http://localhost:3000