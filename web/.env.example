# Sanity project used by the Next.js application.
NEXT_SANITY_PROJECT_ID=YOUR-PROJECT-ID

# Sanity dataset used by the Next.js application.
NEXT_SANITY_DATASET=production

# Matching Sanity Studio URL used by visual editing/source maps.
NEXT_SANITY_STUDIO_URL=http://localhost:3333

# Server-only token with write access for features that mutate Sanity,
# such as Poll voting. Never expose this with NEXT_PUBLIC_*.
SANITY_API_WRITE_TOKEN=YOUR-WRITE-TOKEN-HERE

# Server-only Viewer/read token used for Draft Mode/draft perspective reads.
# Never expose this with NEXT_PUBLIC_*.
SANITY_API_READ_TOKEN=YOUR-READ-TOKEN-HERE

# Shared secret used to verify signed Sanity document-webhook requests
# sent to POST /api/revalidate.
SANITY_REVALIDATE_SECRET=YOUR-REVALIDATION-SECRET-HERE
